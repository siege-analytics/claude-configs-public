{
  "schema_version": 1,
  "contract_version": "1.2.0",
  "ontology_version": "1.0.0",
  "decision_values": [
    "allow",
    "deny",
    "not-applicable",
    "unknown",
    "error"
  ],
  "capability_states": [
    "verified",
    "unsupported",
    "unverified"
  ],
  "policy_fields": [
    {
      "id": "branch-policy",
      "ontology_term": "policy",
      "owner": "parent-scaffold",
      "scope": "repository",
      "value_schema": {
        "type": "object",
        "properties": {
          "integration_branch": {
            "type": "string",
            "enum": [
              "develop",
              "main"
            ]
          },
          "local_feedback": {
            "type": "string",
            "enum": [
              "native-git-pre-push"
            ]
          },
          "protected_acceptance": {
            "type": "string",
            "enum": [
              "exact-range-and-head"
            ]
          }
        },
        "required": [
          "integration_branch",
          "local_feedback",
          "protected_acceptance"
        ],
        "additional_properties": false
      },
      "default": {
        "integration_branch": "develop",
        "local_feedback": "native-git-pre-push",
        "protected_acceptance": "exact-range-and-head"
      },
      "override_policy": {
        "organization_profile_paths": [
          "integration_branch"
        ],
        "project_paths": [],
        "locked_paths": [
          "local_feedback",
          "protected_acceptance"
        ]
      },
      "required_capability_ids": [
        "native-branch-pre-push",
        "protected-range-validation"
      ]
    },
    {
      "id": "ticket-requirement",
      "ontology_term": "policy",
      "owner": "parent-scaffold",
      "scope": "commit-message",
      "value_schema": {
        "type": "object",
        "properties": {
          "required": {
            "type": "boolean"
          },
          "match_policy": {
            "type": "string",
            "enum": [
              "canonical-ticket-reference-v1"
            ]
          },
          "exception_policy": {
            "type": "string",
            "enum": [
              "scoped-evidence-record-only"
            ]
          }
        },
        "required": [
          "required",
          "match_policy",
          "exception_policy"
        ],
        "additional_properties": false
      },
      "default": {
        "required": true,
        "match_policy": "canonical-ticket-reference-v1",
        "exception_policy": "scoped-evidence-record-only"
      },
      "override_policy": {
        "organization_profile_paths": [],
        "project_paths": [],
        "locked_paths": [
          "required",
          "match_policy",
          "exception_policy"
        ]
      },
      "required_capability_ids": [
        "native-ticket-commit-msg",
        "protected-range-validation"
      ]
    },
    {
      "id": "review-procedure-binding",
      "ontology_term": "procedure-binding",
      "owner": "parent-scaffold",
      "scope": "review-procedure",
      "value_schema": {
        "type": "object",
        "properties": {
          "procedure": {
            "type": "string",
            "pattern": "[a-z][a-z0-9-]*(?:--[a-z][a-z0-9-]*)?"
          },
          "authorization_effect": {
            "type": "string",
            "enum": [
              "none"
            ]
          }
        },
        "required": [
          "procedure",
          "authorization_effect"
        ],
        "additional_properties": false
      },
      "default": {
        "procedure": "self-review",
        "authorization_effect": "none"
      },
      "override_policy": {
        "organization_profile_paths": [],
        "project_paths": [
          "procedure"
        ],
        "locked_paths": [
          "authorization_effect"
        ]
      },
      "required_capability_ids": [
        "procedure-binding-resolution"
      ]
    }
  ],
  "capabilities": [
    {
      "id": "native-ticket-commit-msg",
      "ontology_term": "host-capability",
      "boundary": "native-git-commit-msg",
      "kind": "executable",
      "registered_path": ".githooks/commit-msg",
      "input_contract": [
        "commit-message-file",
        "staged-paths"
      ],
      "result_contract": {
        "type": "process-exit",
        "allow": [
          0
        ],
        "deny": [
          1
        ],
        "error": [
          2
        ]
      },
      "failure_semantics": "error-never-allow",
      "package_paths": [
        "dist/craft-agent/.githooks/commit-msg"
      ],
      "acceptance_probe_ids": [
        "ticket-valid-reference-allows",
        "ticket-missing-reference-denies"
      ],
      "configured_evidence_only": true
    },
    {
      "id": "native-branch-pre-push",
      "ontology_term": "host-capability",
      "boundary": "native-git-pre-push",
      "kind": "generated-executable",
      "registered_path": "dist/craft-agent/.githooks/pre-push",
      "input_contract": [
        "push-update-lines",
        "repository-state"
      ],
      "result_contract": {
        "type": "process-exit",
        "allow": [
          0
        ],
        "deny": [
          1
        ],
        "error": [
          2
        ]
      },
      "failure_semantics": "error-never-allow",
      "package_paths": [
        "dist/craft-agent/.githooks/pre-push"
      ],
      "acceptance_probe_ids": [
        "branch-protected-update-denies"
      ],
      "configured_evidence_only": true
    },
    {
      "id": "protected-range-validation",
      "ontology_term": "host-capability",
      "boundary": "protected-acceptance",
      "kind": "external",
      "registered_path": ".github/workflows/pr-base-guard.yml",
      "input_contract": [
        "trusted-base-revision",
        "canonical-repository-identity",
        "candidate-source-identity",
        "exact-base",
        "exact-head",
        "authenticated-head-branch",
        "target-branch",
        "complete-commit-range"
      ],
      "result_contract": {
        "type": "protected-check",
        "allow": [
          0
        ],
        "deny": [
          1
        ],
        "error": [
          2
        ]
      },
      "failure_semantics": "unknown-never-allow",
      "package_paths": [],
      "acceptance_probe_ids": [
        "protected-invalid-range-denies",
        "protected-stale-head-denies",
        "protected-wrong-repository-denies",
        "protected-interior-commit-denies"
      ],
      "configured_evidence_only": true
    },
    {
      "id": "procedure-binding-resolution",
      "ontology_term": "host-capability",
      "boundary": "procedure-selection",
      "kind": "declarative",
      "registered_path": "skills/self-review/SKILL.md",
      "input_contract": [
        "qualified-procedure-id",
        "repository-identity"
      ],
      "result_contract": {
        "type": "decision",
        "allow": [
          0
        ],
        "deny": [
          1
        ],
        "error": [
          2
        ]
      },
      "failure_semantics": "unknown-never-allow",
      "package_paths": [
        "dist/craft-agent/skills/self-review/SKILL.md"
      ],
      "acceptance_probe_ids": [
        "qualified-procedure-resolves-once"
      ],
      "configured_evidence_only": true
    }
  ]
}
