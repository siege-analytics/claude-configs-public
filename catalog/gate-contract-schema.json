{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/siege-analytics/claude-configs-public/catalog/gate-contract-schema.json",
  "title": "Bounded gate and capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "ontology_version",
    "decision_values",
    "capability_states",
    "policy_fields",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ontology_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "decision_values": {
      "const": [
        "allow",
        "deny",
        "not-applicable",
        "unknown",
        "error"
      ]
    },
    "capability_states": {
      "const": [
        "verified",
        "unsupported",
        "unverified"
      ]
    },
    "policy_fields": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/policy_field"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "string_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "value_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "properties",
        "required",
        "additional_properties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "minProperties": 1
        },
        "required": {
          "$ref": "#/$defs/string_list"
        },
        "additional_properties": {
          "const": false
        }
      }
    },
    "override_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_profile_paths",
        "project_paths",
        "locked_paths"
      ],
      "properties": {
        "organization_profile_paths": {
          "$ref": "#/$defs/string_list"
        },
        "project_paths": {
          "$ref": "#/$defs/string_list"
        },
        "locked_paths": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "policy_field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ontology_term",
        "owner",
        "scope",
        "value_schema",
        "default",
        "override_policy",
        "required_capability_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "ontology_term": {
          "enum": [
            "policy",
            "procedure-binding"
          ]
        },
        "owner": {
          "$ref": "#/$defs/identifier"
        },
        "scope": {
          "$ref": "#/$defs/identifier"
        },
        "value_schema": {
          "$ref": "#/$defs/value_schema"
        },
        "default": {
          "type": "object"
        },
        "override_policy": {
          "$ref": "#/$defs/override_policy"
        },
        "required_capability_ids": {
          "$ref": "#/$defs/string_list"
        }
      }
    },
    "result_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "allow",
        "deny",
        "error"
      ],
      "properties": {
        "type": {
          "enum": [
            "process-exit",
            "protected-check",
            "decision"
          ]
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "error": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ontology_term",
        "boundary",
        "kind",
        "registered_path",
        "input_contract",
        "result_contract",
        "failure_semantics",
        "package_paths",
        "acceptance_probe_ids",
        "configured_evidence_only"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "ontology_term": {
          "const": "host-capability"
        },
        "boundary": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "executable",
            "generated-executable",
            "external",
            "declarative"
          ]
        },
        "registered_path": {
          "type": "string",
          "minLength": 1
        },
        "input_contract": {
          "$ref": "#/$defs/string_list"
        },
        "result_contract": {
          "$ref": "#/$defs/result_contract"
        },
        "failure_semantics": {
          "enum": [
            "error-never-allow",
            "unknown-never-allow"
          ]
        },
        "package_paths": {
          "$ref": "#/$defs/string_list"
        },
        "acceptance_probe_ids": {
          "$ref": "#/$defs/string_list"
        },
        "configured_evidence_only": {
          "const": true
        }
      }
    }
  }
}
