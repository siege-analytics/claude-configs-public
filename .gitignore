# Credentials and secrets
.credentials.json
*.key
*.pem
secrets.*

# Session data (large, ephemeral)
*.jsonl
*.jsonl.gz

# Machine-local hook wiring (generated by bin/install-hooks.sh)
.claude/settings.local.json

# Cache and telemetry
cache/
telemetry/
statsig/
debug/
paste-cache/
shell-snapshots/
downloads/
file-history/
session-env/
dist/
dist.stale/
__pycache__/
*.py[cod]

# Machine-local editor state
.idea/

# Repo test fixtures must be tracked regardless of a developer global
# gitignore, which commonly excludes test_*.py and *_test.py. A repo
# .gitignore takes precedence over core.excludesFile, so this re-includes them.
!bin/_test/*.py
