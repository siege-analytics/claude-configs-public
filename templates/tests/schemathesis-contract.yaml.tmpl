# Schemathesis contract stub for ticket #{ticket_id}, AC{ac_id}: {feature}.
#
# Generated by the scaffold hook from templates/tests/schemathesis-contract.yaml.tmpl.
# Renders a placeholder Schemathesis configuration that MUST fail when run
# against an unimplemented target.
#
# Contract: this config MUST fail with a message naming the AC when run
# against an unimplemented target. Replace the placeholder base_url and
# checks with the real API surface once the feature exists.

schemathesis:
  # Ticket reference
  ticket: "{ticket_id}"
  ac: "AC{ac_id}"
  feature: "{feature}"

  # Base URL of the API under test. Replace with the real deployment when
  # the feature lands.
  base_url: "https://placeholder.example.invalid/ac{ac_id}"

  # OpenAPI / GraphQL schema location. Replace with the real path.
  schema_path: "openapi.json"

  # Fail-with-AC-message contract: force schemathesis to fail until
  # implementer fills in the real endpoint + assertions.
  checks:
    - name: "AC{ac_id}_not_implemented"
      description: |
        AC{ac_id} for ticket #{ticket_id} ({feature}) is not implemented.
        Replace this check with the assertion the AC's Falsifiable-by
        clause names.
      must_pass: false
      raises_on_run: "AC{ac_id} for ticket #{ticket_id} ({feature}) is not implemented."
