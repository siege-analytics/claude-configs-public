#!/bin/bash
# Native git commit-msg hook for claude-configs-public.
#
# Enforces Self-Review trailers and ticket references on all commits
# regardless of execution environment (Craft Agent, Claude Code, manual).
#
# This is the Layer 3 enforcement referenced in self-review/SKILL.md's
# "Cross-environment enforcement" section. It fires for all push sources
# because it is a native git hook, not a Claude Code PreToolUse hook.
#
# Bypass: git commit --no-verify (visible, intentional)
# Escape: [no-review] in commit message for genuinely trivial commits
#
# Install: git config core.hooksPath .githooks
# Or run: bin/install-hooks.sh
#
# Ref: claude-configs-public#355

set -euo pipefail

# Selected registration supplies all policy authority inputs as a host binding.
# The remaining body is the retained repository compatibility wrapper.
if [[ "${1:-}" == "--selected" && $# -ge 2 ]]; then
    shift
    SELECTED_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
    exec python3 -B "$SELECTED_ROOT/bin/native_git.py" commit-msg -- "$@"
fi

[[ $# -eq 1 ]] || { echo "commit-msg: expected one message file" >&2; exit 2; }
COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat -- "$COMMIT_MSG_FILE")

# Parse trailers from the commit message.
TRAILERS=$(echo "$COMMIT_MSG" | git interpret-trailers --parse 2>/dev/null || true)

# Machine-compute the minimum review tier from staged paths. A declaration may
# escalate but never downgrade. Fail closed when the policy/helper is absent.
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
HOOK_ROOT=$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || true)
RISK_SCRIPT="${CLAUDE_CONFIG_ROOT:-$HOOK_ROOT}/bin/review-risk.py"
[[ -f "$RISK_SCRIPT" ]] || RISK_SCRIPT="$REPO_ROOT/bin/review-risk.py"
if [[ ! -f "$RISK_SCRIPT" ]]; then
    echo "BLOCKED: add exactly one Review-Tier: A|B|C trailer; risk classifier unavailable or declaration invalid." >&2
    exit 1
fi
# Every absent or invalid trailer is collected and reported in one rejection
# (#1168). Each pipeline tolerates no-match under set -e/pipefail.
MISSING=()
trailer_example() {
    case "$1" in
        Self-Review) echo "<one-line summary of the review pass>" ;;
        Self-Review-Source) echo "<path or URL to the self-review artifact>" ;;
        Hostile-Review) echo "<URL, #ticket, or committed file with the independent hostile review>" ;;
        Negative-Tests) echo "<negative cases exercised and their result>" ;;
        Full-Suite) echo "<full suite command and pass/fail counts>" ;;
        Canary-Rollback) echo "<canary or revert proof, or N/A with reason>" ;;
    esac
}
TIER_VALUE=$(echo "$TRAILERS" | { grep -i '^Review-Tier:' || true; } | sed 's/^[^:]*:[[:space:]]*//' | tr '[:lower:]' '[:upper:]')
DECLARED=""; [[ "$TIER_VALUE" =~ ^[ABC]$ ]] && DECLARED="$TIER_VALUE"
PROTECTED_RE='^(bin/review-risk\.py|catalog/review-risk-policy\.json|\.githooks/commit-msg|hooks/git/(self-review|pre-push-self-review)\.sh)$'
PROTECTED=false
if git diff --cached --no-renames --name-only --diff-filter=ACDMRT | grep -Eq "$PROTECTED_RE"; then PROTECTED=true; fi
RISK_RESULT=$(python3 "$RISK_SCRIPT" --repo "$REPO_ROOT" --staged ${DECLARED:+--declared "$DECLARED"} 2>&1) && RISK_OK=true || RISK_OK=false
# The classifier prints one JSON line last; interpreter warnings on stderr must
# not turn into a classifier failure.
COMPUTED=$(printf '%s' "$RISK_RESULT" | python3 -c 'import json,sys; print(json.loads(sys.stdin.read().strip().splitlines()[-1]).get("computed_tier", ""))' 2>/dev/null || true)
if [[ ! "$COMPUTED" =~ ^[ABC]$ ]]; then
    echo "BLOCKED: review tier downgrade or classifier failure: $RISK_RESULT" >&2
    exit 1
fi
REQUIRED="$COMPUTED"; [[ "$PROTECTED" == "true" ]] && REQUIRED="C"
if [[ -z "$DECLARED" ]]; then
    MISSING+=("Review-Tier: $REQUIRED  (exactly one Review-Tier: A|B|C trailer; computed minimum is Tier $REQUIRED)")
    TIER_VALUE="$REQUIRED"
elif [[ "$RISK_OK" != "true" || "$DECLARED" < "$REQUIRED" ]]; then
    NOTE=""
    if [[ "$PROTECTED" == "true" ]]; then NOTE="; review-policy bootstrap files require Tier C"; fi
    MISSING+=("Review-Tier: $REQUIRED  (declared Tier $DECLARED is below the required Tier $REQUIRED$NOTE)")
    TIER_VALUE="$REQUIRED"
fi

# Ticket traceability remains universal, including Tier A and [no-review].
if ! echo "$COMMIT_MSG" | grep -qE '(#[0-9]+|\[no-ticket\])'; then
    MISSING+=("ticket reference: #NNN in the message, or [no-ticket] if exempt")
fi

# The legacy escape is valid only for computed Tier A. Tier B/C can never
# suppress review by adding a message token.
NO_REVIEW_A=false
if echo "$COMMIT_MSG" | grep -qF '[no-review]'; then
    if [[ "$TIER_VALUE" == "A" ]]; then
        NO_REVIEW_A=true
    else
        MISSING+=("remove [no-review]: it is permitted only for validated Tier A changes")
    fi
fi

if [[ "$NO_REVIEW_A" != "true" ]] && ! echo "$TRAILERS" | grep -qi '^Self-Review:[[:space:]]*\S'; then
    MISSING+=("Self-Review: $(trailer_example Self-Review)")
fi
# Tier B/C require a durable focused/full artifact.
if [[ "$TIER_VALUE" != "A" ]] && ! echo "$TRAILERS" | grep -qi '^Self-Review-Source:[[:space:]]*\S'; then
    MISSING+=("Self-Review-Source: $(trailer_example Self-Review-Source)")
fi
if [[ "$TIER_VALUE" == "C" ]]; then
    for REQUIRED_TRAILER in "Hostile-Review" "Negative-Tests" "Full-Suite" "Canary-Rollback"; do
        COUNT=$(echo "$TRAILERS" | { grep -ci "^${REQUIRED_TRAILER}:[[:space:]]*\S" || true; })
        if [[ "$COUNT" -ne 1 ]]; then
            MISSING+=("${REQUIRED_TRAILER}: $(trailer_example "$REQUIRED_TRAILER")  (Tier C requires exactly one; found $COUNT)")
        fi
    done
fi

if [[ ${#MISSING[@]} -gt 0 ]]; then
    {
        echo ""
        echo "BLOCKED: commit message lacks ${#MISSING[@]} required review item(s) for Tier $TIER_VALUE."
        echo "Add every item below in one edit, then retry:"
        printf '  - %s\n' "${MISSING[@]}"
        echo ""
        echo "For genuinely trivial Tier A commits, [no-review] replaces Self-Review:."
        echo "See: skills/self-review/SKILL.md. Ref: #355, #1168"
    } >&2
    exit 1
fi

# Tier A's short review record is the Self-Review line itself.
if [[ "$TIER_VALUE" == "A" ]]; then
    exit 0
fi

# If Self-Review-Source is a file path (not a URL), verify it exists
SOURCE_VALUE=$(echo "$TRAILERS" | grep -i '^Self-Review-Source:' | head -1 | sed 's/^[^:]*:[[:space:]]*//')
if [ -n "$SOURCE_VALUE" ] && ! echo "$SOURCE_VALUE" | grep -qE '^(https?://|#[0-9]+$)'; then
    if [ -f "$SOURCE_VALUE" ]; then
        MISSING_SECTIONS=""
        if [[ "$TIER_VALUE" == "B" ]]; then
            REQUIRED_SECTIONS=("## Assumptions" "## Test plan")
        else
            REQUIRED_SECTIONS=("## Assumptions" "## Peer review" "## Lead review" "## Quantified claims")
        fi
        for SECTION in "${REQUIRED_SECTIONS[@]}"; do
            if ! grep -qF "$SECTION" "$SOURCE_VALUE"; then
                MISSING_SECTIONS="$MISSING_SECTIONS\n  - $SECTION"
            fi
        done
        if [ -n "$MISSING_SECTIONS" ]; then
            echo ""
            echo "BLOCKED: Self-review artifact missing required sections:"
            echo -e "$MISSING_SECTIONS"
            echo ""
            echo "See: skills/self-review/SKILL.md"
            exit 1
        fi
        if [[ "$TIER_VALUE" == "C" ]]; then
            for FIELD in "Pre-mortem-artifact" "Hostile-review-artifact"; do
                if ! grep -qE "^${FIELD}:[[:space:]]+\S" "$SOURCE_VALUE"; then
                    echo "BLOCKED: Tier C artifact requires non-empty ${FIELD}: evidence." >&2
                    exit 1
                fi
            done
        fi
    else
        echo "BLOCKED: Self-Review-Source file not found: $SOURCE_VALUE" >&2
        exit 1
    fi
fi

exit 0
